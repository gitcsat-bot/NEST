{
  "name": "nest-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "NEST \u2014 Networked Equipment & Stock Tracker (monorepo root)",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:backend": "pnpm --filter @nest/backend dev",
    "dev:frontend": "pnpm --filter @nest/frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter @nest/backend prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @nest/backend prisma:migrate:dev"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "typescript": "^5.5.0",
    "prettier": "^3.3.0"
  }
}
