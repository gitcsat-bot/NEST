# ==========================================
# NEST Frontend Environment Variables
# ==========================================

# Base URL for the NestJS Backend API.
# 
# For Local Development: 
# Since Vite proxies `/api/v1` to `http://localhost:3000` automatically 
# (via vite.config.ts), you can usually leave this as just `/api/v1`.
# Alternatively, to bypass the proxy or run frontend on a separate domain,
# set this to the absolute backend URL, e.g., "http://localhost:3000/api/v1"
#
# For Production (using Nginx/PM2 on same domain):
# If Nginx proxies `/api` to the backend, keep this as "/api/v1".
VITE_API_BASE_URL="/api/v1"
