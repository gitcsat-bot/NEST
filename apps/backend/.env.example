# ==========================================
# NEST Backend Environment Variables
# ==========================================
# Placeholder values only - see Security Design §10. Never commit real values.

# ----------------------------------------------------
# 1. DATABASE CONFIGURATION
# ----------------------------------------------------
# DATABASE_URL is read by Prisma's CLI (migrate dev/deploy, db seed) —
# that's a Prisma convention, not ours, so this MUST stay named exactly
# this. It connects as nest_migrator (DDL rights) — see Database Design §7.
DATABASE_URL="postgresql://nest_migrator:changeme_dev_only@localhost:5432/nest?schema=public"

# APP_DATABASE_URL is what the running backend actually connects as —
# nest_app, least privilege, no DDL, UPDATE/DELETE revoked on audit_log.
# Read explicitly by PrismaService (src/prisma/prisma.service.ts), never
# by the Prisma CLI. These two must point at the SAME database, different roles.
APP_DATABASE_URL="postgresql://nest_app:changeme_dev_only@localhost:5432/nest?schema=public"

# ----------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS
# ----------------------------------------------------
# Name of the HTTPOnly cookie storing the session token.
SESSION_COOKIE_NAME="nest_session"

# Cryptographic secrets. In production, generate 32-byte (or longer) random strings for these!
# e.g., using `openssl rand -hex 32`
SESSION_SIGNING_SECRET="replace-with-a-generated-32-byte-secret"
TOTP_ENCRYPTION_KEY="replace-with-a-generated-32-byte-key"
CSRF_SECRET="replace-with-a-generated-secret"

# ----------------------------------------------------
# 3. SERVER & CORS CONFIGURATION
# ----------------------------------------------------
# Allowed origin for Cross-Origin Resource Sharing (CORS).
# For local dev with Vite, this is usually http://localhost:5173.
# For local dev where frontend is accessed via network, e.g. http://192.168.1.100:5173
# For production, set this to your exact frontend domain, e.g., https://app.yourdomain.com
CORS_ALLOWED_ORIGIN="http://localhost:5173"

# The port the NestJS backend API will listen on.
PORT=3000

# Set to "production" in prod environments (disables stack traces in errors, etc.)
NODE_ENV="development"

# ----------------------------------------------------
# 4. SMTP / EMAIL CONFIGURATION
# ----------------------------------------------------
# Configuration for the email worker to send OTPs, approvals, etc.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false" # Set true if using port 465
SMTP_USER="your-smtp-username@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
SMTP_FROM="no-reply@yourdomain.com"