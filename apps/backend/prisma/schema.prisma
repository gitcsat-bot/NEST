// NEST — Prisma schema
// Source of truth: NEST Database Design (all sections referenced inline below).
// This is a direct translation of that document's DDL into Prisma's schema
// language, per ADR-004 ("Prisma Migrate for schema migrations"). Any
// divergence from the Database Design here is a bug, not a design decision —
// changes to the data model happen in that document first.
//
// NOTE ON GRANTS (Database Design §7): Prisma does not express GRANT/REVOKE
// statements. The `nest_app` / `nest_migrator` role split and the
// REVOKE UPDATE, DELETE ON audit_log / inventory_transactions statements are
// applied via a raw-SQL migration appended after `prisma migrate dev` first
// generates the base schema — see prisma/migrations/<timestamp>_grants/migration.sql
// (added once the first migration exists; not generated by `prisma db push`).

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgcrypto: gen_random_uuid() (Database Design §1, PK generation)
  // ltree: locations.path_cache subtree queries (Database Design §4.6, §9.2 of the TDS)
  // citext: case-insensitive users.email uniqueness (Database Design §4.1)
  extensions = [pgcrypto, ltree, citext]
}

// ---------------------------------------------------------------------------
// Enums — Database Design §3
// ---------------------------------------------------------------------------

enum UserRole {
  viewer
  student
  contributor
  stores_manager
  admin
}

enum LocationType {
  warehouse
  room
  cabinet
  rack
  shelf
  bin
  box
  position
  other
}

enum LocationStatus {
  OPEN     @map("open")
  CLOSED   @map("closed")
  LOCKED   @map("locked")

  @@map("location_statuses")
}

enum AssetStatus {
  registered
  available
  reserved
  issued
  damaged
  under_repair
  lost
  retired
  disposed
}

enum InventoryTransactionType {
  receive
  issue
  consume
  return
  adjust
  transfer_out
  transfer_in
  reconciliation
  dispose
}

enum ReservationStatus {
  active
  fulfilled
  cancelled
  expired
}

enum AttachmentStatus {
  pending_scan
  available
  quarantined
  failed
}

enum RelationshipType {
  contains
  mounted_on
  subsystem_of
  spare_for
}

enum PolymorphicTargetType {
  asset_instance
  inventory_item
}

// ---------------------------------------------------------------------------
// Auth & identity — Database Design §4.1-4.5
// ---------------------------------------------------------------------------

// New account fields (Phase 1 follow-up): college MIS ID + gender,
// collected at registration. `misId` is validated as exactly 9 digits at
// the DTO layer (RegisterDto) — the format is understood to encode
// admission-year/department/roll-number per the institution's own MIS
// scheme, but this app deliberately does not parse or decode that
// internal structure; it's stored and used only as a unique identifier
// (see the unique index below), not derived for any other purpose.
enum Gender {
  male
  female
  other
  prefer_not_to_say
}

// Email worker (this note explains why it's a Postgres table and not
// BullMQ+Redis — see MailService's doc comment for the full story).
enum EmailStatus {
  pending
  sent
  failed
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique @db.Citext
  passwordHash     String    @map("password_hash")
  displayName      String    @map("display_name")
  role             UserRole  @default(viewer)
  pendingRole      UserRole? @map("pending_role")
  misId            String?   @unique @map("mis_id") @db.VarChar(9)
  gender           Gender?
  whatsappNumber   String?   @map("whatsapp_number") @db.VarChar(15)
  subsystem        String?   @db.VarChar(50)
  teamRole         String?   @map("team_role") @db.VarChar(50)
  isActive         Boolean   @default(true) @map("is_active")
  emailVerified    Boolean   @default(false) @map("email_verified")
  totpEnabled      Boolean   @default(false) @map("totp_enabled")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deactivatedAt    DateTime? @map("deactivated_at") @db.Timestamptz

  sessions                Session[]
  totpCredential          TotpCredential?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogEntries         AuditLog[]               @relation("AuditActor")

  catalogDeletionRequestsMade     CatalogDeletionRequest[] @relation("CatalogDeletionRequestedBy")
  catalogDeletionRequestsReviewed CatalogDeletionRequest[] @relation("CatalogDeletionReviewedBy")

  assetInstancesCreated AssetInstance[] @relation("AssetInstanceCreatedBy")
  assetInstancesUpdated AssetInstance[] @relation("AssetInstanceUpdatedBy")
  assetInstancesHeld    AssetInstance[] @relation("AssetInstanceHeldBy")

  inventoryTransactionsActed InventoryTransaction[] @relation("InventoryTransactionActor")

  checkoutsHeld         Checkout[] @relation("CheckoutHeldBy")
  checkoutsProcessedOut Checkout[] @relation("CheckoutOutBy")
  checkoutsProcessedIn  Checkout[] @relation("CheckoutInBy")

  movementEventsMoved MovementEvent[] @relation("MovementEventMovedBy")

  reservationsReservedFor Reservation[] @relation("ReservationFor")
  reservationsRequestedBy Reservation[] @relation("ReservationRequestedBy")

  relationshipsCreated AssetRelationship[] @relation("RelationshipCreatedBy")
  attachmentsUploaded  Attachment[]        @relation("AttachmentUploadedBy")

  @@index([role], map: "idx_users_role")
  @@map("users")
}

// Session `id` stores a SHA-256 hash of the client-side token, never the
// token itself — Database Design §4.2, TDS §12.1.
model Session {
  id               String    @id @db.VarChar(64)
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  stepUpVerifiedAt DateTime? @map("step_up_verified_at") @db.Timestamptz
  ipAddress        String    @map("ip_address") @db.Inet
  userAgent        String    @map("user_agent")

  @@index([userId], map: "idx_sessions_user_active")
  @@index([expiresAt], map: "idx_sessions_expiry")
  @@map("sessions")
}

model TotpCredential {
  userId          String   @id @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted Bytes    @map("secret_encrypted")
  enrolledAt      DateTime @default(now()) @map("enrolled_at") @db.Timestamptz
  // Shape: [{ "hash": string, "used_at": string | null }, ...] — TDS §3.4
  recoveryCodes   Json     @default("[]") @map("recovery_codes")

  @@map("totp_credentials")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, usedAt], map: "idx_password_reset_user")
  @@map("password_reset_tokens")
}

// Phase-2 seam (TDS §3.6, ADR: not read on the hot path in MVP — the
// RolesGuard uses an in-code static table for speed; this exists so a
// future permission model is a data change, not an architecture change).
model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         UserRole
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

// Single-row org configuration — Database Design §4.18.
model SecuritySettings {
  id                           Int      @id @default(1)
  require2faForViewer          Boolean  @default(false) @map("require_2fa_for_viewer")
  sessionIdleTimeoutMinutes    Int      @default(45) @map("session_idle_timeout_minutes")
  sessionAbsoluteLifetimeHours Int      @default(12) @map("session_absolute_lifetime_hours")
  largeReconciliationThreshold Int      @default(100) @map("large_reconciliation_threshold")
  updatedBy                    String?  @map("updated_by") @db.Uuid
  updatedAt                    DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("security_settings")
}

// ---------------------------------------------------------------------------
// Audit — Database Design §4.17. Append-only: no updatedAt, no deletedAt.
// The nest_app DB role has UPDATE/DELETE revoked on this table (§7) — that
// grant is applied via raw SQL, not expressible in this schema file.
// ---------------------------------------------------------------------------

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  sessionId   String?  @map("session_id") @db.VarChar(64)
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorUserId, createdAt], map: "idx_audit_actor_time")
  @@index([targetType, targetId], map: "idx_audit_target")
  @@index([action, createdAt], map: "idx_audit_action_time")
  @@index([createdAt], map: "idx_audit_created_at")
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Locations — Database Design §4.6
// ---------------------------------------------------------------------------

model Location {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  type             LocationType
  parentLocationId String?      @map("parent_location_id") @db.Uuid
  parentLocation   Location?    @relation("LocationTree", fields: [parentLocationId], references: [id], onDelete: Restrict)
  childLocations   Location[]   @relation("LocationTree")
  description      String?
  status           LocationStatus @default(OPEN)
  isActive         Boolean      @default(true) @map("is_active")

  // Note: ltree path cache is typically maintained by service/triggers, prisma can only declare it
  pathCache Unsupported("ltree")? @map("path_cache")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assetInstances AssetInstance[]
  inventoryItems InventoryItem[]

  inventoryTransactions InventoryTransaction[]
  movementEventsFrom    MovementEvent[]        @relation("MovementEventFrom")
  movementEventsTo      MovementEvent[]        @relation("MovementEventTo")

  @@index([parentLocationId], map: "idx_locations_parent")
  @@index([pathCache], type: Gist)
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Catalog (Asset Definitions) — Database Design §4.7
// ---------------------------------------------------------------------------

model AssetDefinition {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku          String                   @unique @map("part_number") @db.VarChar(50) // Renamed internally based on DDL
  name         String                   @db.VarChar(200)
  category     String                   @default("Uncategorized") @db.VarChar(100) // from DDL
  description  String?                  @db.Text
  manufacturer String?                  @db.VarChar(100)
  datasheetUrl String?                  @map("datasheet_url")
  searchVector Unsupported("tsvector")? @map("search_vector")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?                @map("deleted_at") @db.Timestamptz

  deletionRequests CatalogDeletionRequest[]
  assetInstances   AssetInstance[]
  inventoryItems   InventoryItem[]

  @@index([searchVector], type: Gin)
  @@index([category], map: "idx_asset_definitions_category")
  @@index([sku], map: "idx_asset_definitions_part_number")
  @@map("asset_definitions")
}

// Student-initiated "please delete this catalog item" workflow, reviewed
// by an admin — mirrors InventoryRequest's shape deliberately (same
// pending/approved/rejected lifecycle). Since we removed InventoryRequestStatus,
// we just add a small enum for this request.
enum CatalogDeletionRequestStatus {
  pending
  approved
  rejected
}

model CatalogDeletionRequest {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetDefinitionId String                       @map("asset_definition_id") @db.Uuid
  assetDefinition   AssetDefinition              @relation(fields: [assetDefinitionId], references: [id], onDelete: Cascade)
  requestedByUserId String                       @map("requested_by_user_id") @db.Uuid
  requestedBy       User                         @relation("CatalogDeletionRequestedBy", fields: [requestedByUserId], references: [id])
  reason            String?
  status            CatalogDeletionRequestStatus @default(pending)
  reviewedByUserId  String?                      @map("reviewed_by_user_id") @db.Uuid
  reviewedBy        User?                        @relation("CatalogDeletionReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?                    @map("reviewed_at") @db.Timestamptz
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz

  @@index([status], map: "idx_catalog_deletion_requests_status")
  @@index([assetDefinitionId], map: "idx_catalog_deletion_requests_asset_definition")
  @@map("catalog_deletion_requests")
}

// Email worker
model EmailOutboxMessage {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toEmail   String      @map("to_email")
  subject   String
  bodyText  String      @map("body_text")
  status    EmailStatus @default(pending)
  attempts  Int         @default(0)
  lastError String?     @map("last_error")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  sentAt    DateTime?   @map("sent_at") @db.Timestamptz

  @@index([status], map: "idx_email_outbox_status")
  @@map("email_outbox")
}

// ---------------------------------------------------------------------------
// Projects — Database Design §4.16
// ---------------------------------------------------------------------------
model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  assetInstances        AssetInstance[]
  inventoryTransactions InventoryTransaction[]

  @@map("projects")
}

// ---------------------------------------------------------------------------
// Asset Instances — Database Design §4.8
// ---------------------------------------------------------------------------
model AssetInstance {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayCode         String          @unique @map("display_code")
  assetDefinitionId   String          @map("asset_definition_id") @db.Uuid
  assetDefinition     AssetDefinition @relation(fields: [assetDefinitionId], references: [id], onDelete: Restrict)
  serialNumber        String?         @unique @map("serial_number")
  status              AssetStatus     @default(registered)
  currentLocationId   String          @map("current_location_id") @db.Uuid
  currentLocation     Location        @relation(fields: [currentLocationId], references: [id], onDelete: Restrict)
  currentHolderUserId String?         @map("current_holder_user_id") @db.Uuid
  currentHolder       User?           @relation("AssetInstanceHeldBy", fields: [currentHolderUserId], references: [id], onDelete: SetNull)
  projectId           String?         @map("project_id") @db.Uuid
  project             Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conditionNote       String?         @map("condition_note")

  createdByUserId String @map("created_by") @db.Uuid
  createdBy       User   @relation("AssetInstanceCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String @map("updated_by") @db.Uuid
  updatedBy       User   @relation("AssetInstanceUpdatedBy", fields: [updatedByUserId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  searchVector Unsupported("tsvector")? @map("search_vector")

  checkouts           Checkout[]
  parentRelationships AssetRelationship[] @relation("RelationshipParent")
  childRelationships  AssetRelationship[] @relation("RelationshipChild")

  @@index([status], map: "idx_asset_instances_status")
  @@index([currentLocationId], map: "idx_asset_instances_location")
  @@index([currentHolderUserId], map: "idx_asset_instances_holder")
  @@index([assetDefinitionId], map: "idx_asset_instances_definition")
  @@index([searchVector], type: Gin)
  @@map("asset_instances")
}

// ---------------------------------------------------------------------------
// Inventory Items — Database Design §4.9
// ---------------------------------------------------------------------------
model InventoryItem {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetDefinitionId String          @map("asset_definition_id") @db.Uuid
  assetDefinition   AssetDefinition @relation(fields: [assetDefinitionId], references: [id], onDelete: Restrict)
  locationId        String          @map("location_id") @db.Uuid
  location          Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit              String
  quantityOnHand    Int             @default(0) @map("quantity_on_hand")
  reorderThreshold  Int?            @map("reorder_threshold")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  transactions InventoryTransaction[]

  @@unique([assetDefinitionId, locationId])
  @@index([locationId], map: "idx_inventory_items_location")
  // Note: pg low_stock index condition is not perfectly expressible in prisma so we skip it or use a normal index
  @@index([assetDefinitionId], map: "idx_inventory_items_def")
  @@map("inventory_items")
}

// ---------------------------------------------------------------------------
// Inventory Transactions — Database Design §4.10
// ---------------------------------------------------------------------------
model InventoryTransaction {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId   String                   @map("inventory_item_id") @db.Uuid
  inventoryItem     InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  type              InventoryTransactionType
  quantityDelta     Int                      @map("quantity_delta")
  reason            String?
  relatedLocationId String?                  @map("related_location_id") @db.Uuid
  relatedLocation   Location?                @relation(fields: [relatedLocationId], references: [id])
  projectId         String?                  @map("project_id") @db.Uuid
  project           Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actorUserId       String                   @map("actor_user_id") @db.Uuid
  actor             User                     @relation("InventoryTransactionActor", fields: [actorUserId], references: [id])
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  @@index([inventoryItemId, createdAt(sort: Desc)], map: "idx_inventory_transactions_item")
  @@index([type, createdAt(sort: Desc)], map: "idx_inventory_transactions_type")
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// Checkouts — Database Design §4.11
// ---------------------------------------------------------------------------
model Checkout {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetInstanceId String        @map("asset_instance_id") @db.Uuid
  assetInstance   AssetInstance @relation(fields: [assetInstanceId], references: [id], onDelete: Restrict)

  heldByUserId String @map("held_by_user_id") @db.Uuid
  heldBy       User   @relation("CheckoutHeldBy", fields: [heldByUserId], references: [id])

  checkedOutByUserId String   @map("checked_out_by_user_id") @db.Uuid
  checkedOutBy       User     @relation("CheckoutOutBy", fields: [checkedOutByUserId], references: [id])
  checkedOutAt       DateTime @default(now()) @map("checked_out_at") @db.Timestamptz

  checkedInAt       DateTime? @map("checked_in_at") @db.Timestamptz
  checkedInByUserId String?   @map("checked_in_by_user_id") @db.Uuid
  checkedInBy       User?     @relation("CheckoutInBy", fields: [checkedInByUserId], references: [id])

  conditionAtCheckin String?   @map("condition_at_checkin")
  expectedReturnAt   DateTime? @map("expected_return_at") @db.Timestamptz

  // Prisma unique partial index (only open checkout per asset)
  @@unique([assetInstanceId], map: "uq_checkouts_open_per_asset")
  @@index([heldByUserId], map: "idx_checkouts_holder_open")
  @@index([assetInstanceId, checkedOutAt(sort: Desc)], map: "idx_checkouts_asset_history")
  @@map("checkouts")
}

// ---------------------------------------------------------------------------
// Movement Events — Database Design §4.12
// ---------------------------------------------------------------------------
model MovementEvent {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType     PolymorphicTargetType @map("target_type")
  targetId       String                @map("target_id") @db.Uuid
  fromLocationId String?               @map("from_location_id") @db.Uuid
  fromLocation   Location?             @relation("MovementEventFrom", fields: [fromLocationId], references: [id])
  toLocationId   String                @map("to_location_id") @db.Uuid
  toLocation     Location              @relation("MovementEventTo", fields: [toLocationId], references: [id])
  movedByUserId  String                @map("moved_by_user_id") @db.Uuid
  movedBy        User                  @relation("MovementEventMovedBy", fields: [movedByUserId], references: [id])
  movedAt        DateTime              @default(now()) @map("moved_at") @db.Timestamptz
  reason         String?

  @@index([targetType, targetId, movedAt(sort: Desc)], map: "idx_movement_events_target")
  @@map("movement_events")
}

// ---------------------------------------------------------------------------
// Reservations — Database Design §4.13
// ---------------------------------------------------------------------------
model Reservation {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType        PolymorphicTargetType @map("target_type")
  targetId          String                @map("target_id") @db.Uuid
  reservedForUserId String                @map("reserved_for_user_id") @db.Uuid
  reservedFor       User                  @relation("ReservationFor", fields: [reservedForUserId], references: [id])
  requestedByUserId String                @map("requested_by_user_id") @db.Uuid
  requestedBy       User                  @relation("ReservationRequestedBy", fields: [requestedByUserId], references: [id])
  quantity          Int?
  status            ReservationStatus     @default(active)
  expiresAt         DateTime?             @map("expires_at") @db.Timestamptz
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  @@index([targetType, targetId], map: "idx_reservations_target_active")
  @@index([expiresAt], map: "idx_reservations_expiry")
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Asset Relationships — Database Design §4.14
// ---------------------------------------------------------------------------
model AssetRelationship {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentAssetId    String           @map("parent_asset_id") @db.Uuid
  parentAsset      AssetInstance    @relation("RelationshipParent", fields: [parentAssetId], references: [id], onDelete: Restrict)
  childAssetId     String           @map("child_asset_id") @db.Uuid
  childAsset       AssetInstance    @relation("RelationshipChild", fields: [childAssetId], references: [id], onDelete: Restrict)
  relationshipType RelationshipType @map("relationship_type")
  createdByUserId  String           @map("created_by") @db.Uuid
  createdBy        User             @relation("RelationshipCreatedBy", fields: [createdByUserId], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@unique([parentAssetId, childAssetId, relationshipType])
  @@index([parentAssetId], map: "idx_relationships_parent")
  @@index([childAssetId], map: "idx_relationships_child")
  @@map("asset_relationships")
}

// ---------------------------------------------------------------------------
// Attachments — Database Design §4.15
// ---------------------------------------------------------------------------
model Attachment {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType       PolymorphicTargetType @map("target_type")
  targetId         String                @map("target_id") @db.Uuid
  storageKey       String                @unique @map("storage_key")
  originalFilename String                @map("original_filename")
  declaredMimeType String                @map("declared_mime_type")
  detectedMimeType String?               @map("detected_mime_type")
  sizeBytes        BigInt                @map("size_bytes")
  status           AttachmentStatus      @default(pending_scan)
  uploadedByUserId String                @map("uploaded_by_user_id") @db.Uuid
  uploadedBy       User                  @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime              @default(now()) @map("uploaded_at") @db.Timestamptz
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz

  @@index([targetType, targetId], map: "idx_attachments_target")
  @@index([status], map: "idx_attachments_status_pending")
  @@map("attachments")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, usedAt], map: "idx_email_verification_user")
  @@map("email_verification_tokens")
}
